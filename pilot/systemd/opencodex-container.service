[Unit]
Description=Experimental containerized OpenCodex API proxy
Documentation=https://github.com/novelKR/OpenCodex-OCI-Gateway
Wants=network-online.target docker.service
After=network-online.target docker.service
Conflicts=opencodex.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/libexec/opencodex-container verify
ExecStart=/usr/local/libexec/opencodex-container up
ExecStop=/usr/local/libexec/opencodex-container down
TimeoutStartSec=180s
TimeoutStopSec=60s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/opencodex /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
