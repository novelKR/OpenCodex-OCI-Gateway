[Unit]
Description=Cloudflare Tunnel connector for PW OpenCodex Pilot
Documentation=https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/cloudflared/tunnel.token

[Service]
Type=notify
NotifyAccess=all
User=cloudflared
Group=cloudflared
WorkingDirectory=/var/lib/cloudflared
LoadCredential=tunnel.token:/etc/cloudflared/tunnel.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 --loglevel info --transport-loglevel warn run --token-file %d/tunnel.token
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudflared
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
